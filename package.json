		"cn": "^0.5.2",
		"lucide-react": "^1.80.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.5",
		"three": "^0.187.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.10",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.187.0",
		"@vitejs/plugin-react": "^6.3.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
